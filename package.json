{
  "name": "luftujha",
  "version": "1.1.0-dev",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev --host",
    "build": "tsc -b && node scripts/copy-translations.mjs && vp build",
    "build:addon": "npm run build && node scripts/sync-dist.mjs",
    "check": "vp check",
    "lint": "vp check",
    "format": "vp fmt",
    "format:check": "vp check",
    "preview": "vp preview",
    "test": "npm --prefix addon/rootfs/usr/src/app test",
    "docs:dev": "npm --prefix docs run dev",
    "docs:build": "npm --prefix docs run build",
    "docs:start": "npm --prefix docs run start"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/is-prop-valid": "^1.4.0",
    "@mantine/core": "9.6.1",
    "@mantine/dates": "9.6.1",
    "@mantine/form": "9.6.1",
    "@mantine/hooks": "9.6.1",
    "@mantine/notifications": "9.6.1",
    "@tabler/icons-react": "^3.46.0",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "^1.170.33",
    "date-fns": "^4.4.0",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.13",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^25.7.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "baseline-browser-mapping": "^2.11.21",
    "typescript": "^7.0.2",
    "vite-plus": "^0.3.1"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=11.16.0",
      "onFail": "download"
    }
  }
