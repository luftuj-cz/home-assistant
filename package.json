    "@hookform/resolvers": "^5.9.2",
    "@tabler/icons-react": "^3.49.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-router": "^1.170.46",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
