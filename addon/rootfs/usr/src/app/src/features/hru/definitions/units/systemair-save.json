{
  "code": "systemair-save",
  "name": "Systemair SAVE",
  "variables": [
    {
      "name": "power",
      "type": "number",
      "editable": true,
      "onDashboard": true,
      "label": { "text": "hru.power", "translate": true },
      "unit": "%",
      "min": 0,
      "max": 100,
      "maxConfigurable": false,
      "step": 5,
      "defaultValue": 50,
      "class": "power"
    },
    {
      "name": "offset",
      "type": "number",
      "editable": true,
      "onDashboard": false,
      "label": { "text": "hru.offset", "translate": true },
      "unit": "%",
      "min": -20,
      "max": 20,
      "step": 1,
      "defaultValue": 0,
      "class": "other"
    },
    {
      "name": "temperature",
      "type": "number",
      "editable": true,
      "onDashboard": true,
      "label": { "text": "hru.temperature", "translate": true },
      "unit": "˚C",
      "min": 12,
      "max": 30,
      "step": 0.5,
      "class": "temperature"
    },
    {
      "name": "defrostingMode",
      "type": "select",
      "editable": true,
      "onDashboard": false,
      "label": { "text": "hru.defrostingMode", "translate": true },
      "defaultValue": 1,
      "class": "other",
      "options": [
        { "value": 0, "label": { "text": "hru.modes.soft", "translate": true } },
        { "value": 1, "label": { "text": "hru.modes.normal", "translate": true } },
        { "value": 2, "label": { "text": "hru.modes.hard", "translate": true } }
      ]
    },
    {
      "name": "defrosting",
      "type": "boolean",
      "editable": false,
      "onDashboard": true,
      "label": { "text": "hru.defrosting", "translate": true },
      "class": "flag",
      "flag": "positive"
    },
    {
      "name": "heating",
      "type": "boolean",
      "editable": false,
      "onDashboard": true,
      "label": { "text": "hru.heating", "translate": true },
      "class": "flag",
      "flag": "positive"
    },
    {
      "name": "roomTemperature",
      "type": "number",
      "editable": false,
      "onDashboard": true,
      "label": { "text": "hru.roomTemperature", "translate": true },
      "unit": "˚C",
      "class": "temperature"
    },
    {
      "name": "outsideTemperature",
      "type": "number",
      "editable": false,
      "onDashboard": true,
      "label": { "text": "hru.outsideTemperature", "translate": true },
      "unit": "˚C",
      "class": "temperature"
    },
    {
      "name": "supplyTemperature",
      "type": "number",
      "editable": false,
      "onDashboard": true,
      "label": { "text": "hru.supplyTemperature", "translate": true },
      "unit": "˚C",
      "class": "temperature"
    },
    {
      "name": "extractTemperature",
      "type": "number",
      "editable": false,
      "onDashboard": true,
      "label": { "text": "hru.extractTemperature", "translate": true },
      "unit": "˚C",
      "class": "temperature"
    },
    {
      "name": "roomHumidity",
      "type": "number",
      "editable": false,
      "onDashboard": false,
      "label": { "text": "hru.roomHumidity", "translate": true },
      "unit": "%",
      "class": "other"
    },
    {
      "name": "replaceFilterDays",
      "type": "number",
      "editable": false,
      "onDashboard": true,
      "label": { "text": "hru.changeFiltersIn", "translate": true },
      "unit": { "text": "hru.days", "translate": true },
      "class": "other"
    },
    {
      "name": "error",
      "type": "boolean",
      "editable": false,
      "onDashboard": true,
      "label": { "text": "hru.errorState", "translate": true },
      "class": "flag",
      "flag": "negative"
    }
  ],
  "interface-type": "modbus-tcp",
  "integration": {
    "read": [
      {
        "type": "assignment",
        "variable": "$power",
        "value": { "function": "modbus_read_holding", "args": [12978, 1] }
      },
      {
        "type": "assignment",
        "variable": "$temperature",
        "value": {
          "function": "multiply",
          "args": [
            {
              "function": "int16",
              "args": [{ "function": "modbus_read_holding", "args": [2000, 1] }]
            },
            0.1
          ]
        }
      },
      {
        "type": "assignment",
        "variable": "$defrostingMode",
        "value": { "function": "modbus_read_holding", "args": [4000, 1] }
      },
      {
        "type": "assignment",
        "variable": "$defrosting",
        "value": { "function": "modbus_read_input", "args": [3103, 1] }
      },
      {
        "type": "assignment",
        "variable": "$heating",
        "value": { "function": "modbus_read_input", "args": [3102, 1] }
      },
      {
        "type": "assignment",
        "variable": "$roomTemperature",
        "value": {
          "function": "multiply",
          "args": [
            {
              "function": "int16",
              "args": [{ "function": "modbus_read_input", "args": [12543, 1] }]
            },
            0.1
          ]
        }
      },
      {
        "type": "assignment",
        "variable": "$outsideTemperature",
        "value": {
          "function": "multiply",
          "args": [
            {
              "function": "int16",
              "args": [{ "function": "modbus_read_input", "args": [12101, 1] }]
            },
            0.1
          ]
        }
      },
      {
        "type": "assignment",
        "variable": "$supplyTemperature",
        "value": {
          "function": "multiply",
          "args": [
            {
              "function": "int16",
              "args": [{ "function": "modbus_read_input", "args": [12102, 1] }]
            },
            0.1
          ]
        }
      },
      {
        "type": "assignment",
        "variable": "$extractTemperature",
        "value": {
          "function": "multiply",
          "args": [
            {
              "function": "int16",
              "args": [{ "function": "modbus_read_input", "args": [12104, 1] }]
            },
            0.1
          ]
        }
      },
      {
        "type": "assignment",
        "variable": "$roomHumidity",
        "value": { "function": "modbus_read_input", "args": [12135, 1] }
      },
      {
        "type": "assignment",
        "variable": "$replaceFilterDays",
        "value": {
          "function": "round",
          "args": [
            {
              "function": "multiply",
              "args": [
                { "function": "modbus_read_input_uint32_le", "args": [7004] },
                0.000011574074074074073
              ]
            }
          ]
        }
      },
      {
        "type": "assignment",
        "variable": "$error",
        "value": { "function": "modbus_read_input", "args": [15900, 1] }
      }
    ],
    "write": [
      {
        "type": "assignment",
        "variable": "$supply",
        "value": {
          "function": "clamp",
          "args": [{ "function": "round", "args": ["$power"] }, 0, 100]
        }
      },
      {
        "type": "assignment",
        "variable": "$extract",
        "value": {
          "function": "clamp",
          "args": [
            {
              "function": "round",
              "args": [
                {
                  "function": "multiply",
                  "args": ["$power", { "function": "subtract", "args": [100, "$offset"] }, 0.01]
                }
              ]
            },
            0,
            100
          ]
        }
      },
      {
        "type": "action",
        "expression": { "function": "modbus_write_holding", "args": [1161, 1] }
      },
      {
        "type": "action",
        "expression": { "function": "modbus_write_holding", "args": [12928, 1] }
      },
      {
        "type": "action",
        "expression": { "function": "modbus_write_holding", "args": [12929, 1] }
      },
      {
        "type": "action",
        "expression": { "function": "modbus_write_holding", "args": [12978, "$supply"] }
      },
      {
        "type": "action",
        "expression": { "function": "modbus_write_holding", "args": [12979, "$extract"] }
      },
      {
        "type": "action",
        "expression": {
          "function": "modbus_write_holding",
          "args": [
            2000,
            {
              "function": "round",
              "args": [{ "function": "multiply", "args": ["$temperature", 10] }]
            }
          ]
        }
      },
      {
        "type": "action",
        "expression": { "function": "modbus_write_holding", "args": [4000, "$defrostingMode"] }
      }
    ]
  }
}
