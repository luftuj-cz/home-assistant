{
  "code": "domekt-c6",
  "name": "Komfovent Domekt C6",
  "variables": [
    {
      "name": "power",
      "type": "number",
      "editable": true,
      "onDashboard": true,
      "label": { "text": "hru.power", "translate": true },
      "unit": "m³/h",
      "min": 50,
      "max": 600,
      "maxDefault": 300,
      "maxConfigurable": true,
      "step": 10,
      "defaultValue": 150,
      "class": "power"
    },
    {
      "name": "offset",
      "type": "number",
      "editable": true,
      "onDashboard": false,
      "label": { "text": "hru.offset", "translate": true },
      "unit": "%",
      "min": -20,
      "max": 20,
      "step": 1,
      "defaultValue": 0,
      "class": "other"
    },
    {
      "name": "temperature",
      "type": "number",
      "editable": true,
      "onDashboard": true,
      "label": { "text": "hru.temperature", "translate": true },
      "unit": "˚C",
      "min": 5,
      "max": 40,
      "step": 1,
      "defaultValue": 20,
      "class": "temperature"
    },
    {
      "name": "heating",
      "type": "boolean",
      "editable": true,
      "onDashboard": true,
      "label": { "text": "hru.heating", "translate": true },
      "defaultValue": 0,
      "class": "flag",
      "flag": "positive"
    },
    {
      "name": "unitOn",
      "type": "boolean",
      "editable": true,
      "onDashboard": true,
      "label": { "text": "hru.unitOn", "translate": true },
      "defaultValue": 1,
      "class": "flag",
      "flag": "positive"
    },
    {
      "name": "roomTemperature",
      "type": "number",
      "editable": false,
      "onDashboard": true,
      "label": { "text": "hru.roomTemperature", "translate": true },
      "unit": "˚C",
      "class": "temperature"
    },
    {
      "name": "supplyTemperature",
      "type": "number",
      "editable": false,
      "onDashboard": true,
      "label": { "text": "hru.supplyTemperature", "translate": true },
      "unit": "˚C",
      "class": "temperature"
    },
    {
      "name": "filterImpurity",
      "type": "number",
      "editable": false,
      "onDashboard": true,
      "label": { "text": "hru.filterImpurity", "translate": true },
      "unit": "%",
      "class": "other"
    }
  ],
  "interface-type": "modbus-tcp",
  "integration": {
    "read": [
      {
        "type": "assignment",
        "variable": "$supplyHigh",
        "value": { "function": "modbus_read_holding", "args": [106, 1] }
      },
      {
        "type": "assignment",
        "variable": "$power",
        "value": {
          "function": "sum",
          "args": [
            { "function": "multiply", "args": ["$supplyHigh", 65536] },
            { "function": "modbus_read_holding", "args": [107, 1] }
          ]
        }
      },
      {
        "type": "assignment",
        "variable": "$temperature",
        "value": {
          "function": "multiply",
          "args": [
            {
              "function": "int16",
              "args": [{ "function": "modbus_read_holding", "args": [110, 1] }]
            },
            0.1
          ]
        }
      },
      {
        "type": "assignment",
        "variable": "$heating",
        "value": { "function": "modbus_read_holding", "args": [111, 1] }
      },
      {
        "type": "assignment",
        "variable": "$unitOn",
        "value": { "function": "modbus_read_holding", "args": [1, 1] }
      },
      {
        "type": "assignment",
        "variable": "$roomTemperature",
        "value": {
          "function": "multiply",
          "args": [
            {
              "function": "int16",
              "args": [{ "function": "modbus_read_holding", "args": [903, 1] }]
            },
            0.1
          ]
        }
      },
      {
        "type": "assignment",
        "variable": "$supplyTemperature",
        "value": {
          "function": "multiply",
          "args": [
            {
              "function": "int16",
              "args": [{ "function": "modbus_read_holding", "args": [902, 1] }]
            },
            0.1
          ]
        }
      },
      {
        "type": "assignment",
        "variable": "$filterImpurity",
        "value": { "function": "modbus_read_holding", "args": [917, 1] }
      }
    ],
    "write": [
      {
        "type": "assignment",
        "variable": "$supply",
        "value": { "function": "round", "args": ["$power"] }
      },
      {
        "type": "assignment",
        "variable": "$extract",
        "value": {
          "function": "round",
          "args": [
            {
              "function": "multiply",
              "args": ["$power", { "function": "subtract", "args": [100, "$offset"] }, 0.01]
            }
          ]
        }
      },
      {
        "type": "action",
        "expression": {
          "function": "modbus_write_holding_multi",
          "args": [
            106,
            { "function": "bit_rshift", "args": ["$supply", 16] },
            { "function": "bit_and", "args": ["$supply", 65535] }
          ]
        }
      },
      {
        "type": "action",
        "expression": {
          "function": "modbus_write_holding_multi",
          "args": [
            108,
            { "function": "bit_rshift", "args": ["$extract", 16] },
            { "function": "bit_and", "args": ["$extract", 65535] }
          ]
        }
      },
      {
        "type": "action",
        "expression": {
          "function": "modbus_write_holding",
          "args": [
            110,
            {
              "function": "round",
              "args": [{ "function": "multiply", "args": ["$temperature", 10] }]
            }
          ]
        }
      },
      {
        "type": "action",
        "expression": { "function": "modbus_write_holding", "args": [111, "$heating"] }
      },
      {
        "type": "action",
        "expression": { "function": "modbus_write_holding", "args": [5, 2] }
      },
      {
        "type": "action",
        "expression": { "function": "modbus_write_holding", "args": [4, 0] }
      },
      {
        "type": "action",
        "expression": { "function": "modbus_write_holding", "args": [1, "$unitOn"] }
      }
    ]
  }
}
