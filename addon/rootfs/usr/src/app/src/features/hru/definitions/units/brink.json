{
  "code": "brink",
  "name": "Brink",
  "variables": [
    {
      "name": "power",
      "type": "number",
      "editable": true,
      "onDashboard": true,
      "label": { "text": "hru.power", "translate": true },
      "unit": "m³/h",
      "min": 0,
      "maxDefault": 225,
      "maxConfigurable": true,
      "step": 5,
      "class": "power"
    },
    {
      "name": "bypass",
      "type": "select",
      "editable": true,
      "onDashboard": true,
      "label": { "text": "hru.bypass", "translate": true },
      "class": "mode",
      "options": [
        { "value": 0, "label": { "text": "hru.bypassAuto", "translate": true } },
        { "value": 1, "label": { "text": "hru.bypassClosed", "translate": true } },
        { "value": 2, "label": { "text": "hru.bypassOpened", "translate": true } }
      ]
    },
    {
      "name": "flowIn",
      "type": "number",
      "editable": false,
      "onDashboard": true,
      "label": { "text": "hru.flowIn", "translate": true },
      "unit": "m³/h",
      "class": "other"
    },
    {
      "name": "exhaustTemperature",
      "type": "number",
      "editable": false,
      "onDashboard": true,
      "label": { "text": "hru.exhaustTemperature", "translate": true },
      "unit": "˚C",
      "class": "temperature"
    },
    {
      "name": "supplyTemperature",
      "type": "number",
      "editable": false,
      "onDashboard": true,
      "label": { "text": "hru.supplyTemperature", "translate": true },
      "unit": "˚C",
      "class": "temperature"
    },
    {
      "name": "changeFilter",
      "type": "boolean",
      "editable": false,
      "onDashboard": true,
      "label": { "text": "hru.changeFilters", "translate": true },
      "class": "flag",
      "flag": "negative"
    }
  ],
  "interface-type": "modbus-tcp",
  "integration": {
    "read": [
      {
        "type": "assignment",
        "variable": "$power",
        "value": { "function": "modbus_read_holding", "args": [8002, 1] }
      },
      {
        "type": "assignment",
        "variable": "$flowIn",
        "value": { "function": "modbus_read_input", "args": [4032, 1] }
      },
      {
        "type": "assignment",
        "variable": "$exhaustTemperature",
        "value": {
          "function": "multiply",
          "args": [
            {
              "function": "int16",
              "args": [{ "function": "modbus_read_input", "args": [4046, 1] }]
            },
            0.1
          ]
        }
      },
      {
        "type": "assignment",
        "variable": "$supplyTemperature",
        "value": {
          "function": "multiply",
          "args": [
            {
              "function": "int16",
              "args": [{ "function": "modbus_read_input", "args": [4036, 1] }]
            },
            0.1
          ]
        }
      },
      {
        "type": "assignment",
        "variable": "$changeFilter",
        "value": { "function": "modbus_read_input", "args": [4100, 1] }
      },
      {
        "type": "assignment",
        "variable": "$bypass",
        "value": { "function": "modbus_read_holding", "args": [6100, 1] }
      }
    ],
    "write": [
      { "type": "action", "expression": { "function": "modbus_write_holding", "args": [8000, 2] } },
      { "type": "action", "expression": { "function": "delay", "args": [100] } },
      {
        "type": "action",
        "expression": { "function": "modbus_write_holding", "args": [8002, "$power"] }
      },
      {
        "type": "action",
        "expression": { "function": "modbus_write_holding", "args": [6100, "$bypass"] }
      }
    ]
  }
}
