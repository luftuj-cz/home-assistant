{
  "name": "luftuj-backend",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "module": "src/server.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc --project tsconfig.json && npm run build --workspaces --if-present",
    "test": "vitest run",
    "lint": "oxlint . --config ../../../../../oxlint.config.ts",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "archiver": "^8.0.0",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "modbus-serial": "^8.0.25",
    "mqtt": "^5.16.1",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.9",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^5.0.5",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "@serialport/bindings-cpp@13.0.0": true,
    "esbuild@0.28.2": true
  }
}
